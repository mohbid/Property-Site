{
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      ".git",
      ".git/**",
      "**/.git/**",
      "**/node_modules/**",
      "package*.json",
      "*.log",
      "Keyline Solutions – Database – Rules – Firebase console.html"
    ]
  }
}
